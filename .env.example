# Optional Supabase / PostgreSQL configuration
# Note: The app works out of the box with Node 24's built-in ACID SQLite database (data/gamezone.db).
# Use supabase/migrations/001_initial_schema.sql when deploying to Supabase PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC signing secret for staff session cookies (change in production)
AUTH_SECRET=change-me-to-a-long-random-secret-in-production
